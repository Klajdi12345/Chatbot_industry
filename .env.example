# Kopjoje si .env dhe plotëso vlerat. Mos e ngarko .env në GitHub.

# --- Claude AI (opsionale, por e rekomanduar) ---
# Çelësi merret te https://console.anthropic.com  → API Keys
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto            # auto | claude | ollama
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium         # low | medium | high

# --- Ollama (embeddings bge-m3 + model lokal) ---
OLLAMA_LLM_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_THINK_MODEL=qwen3:8b

# --- Neo4j ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_TRANSPORT=bolt

# --- Llogaria admin (krijohet herën e parë) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
