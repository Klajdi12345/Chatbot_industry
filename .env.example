# Kopjoje si .env dhe plotëso vlerat. Mos e ngarko .env në GitHub.

# --- Ollama (embeddings bge-m3 + model lokal) ---
OLLAMA_LLM_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_THINK_MODEL=qwen3:8b

# --- Neo4j ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_TRANSPORT=bolt

# --- Llogaria admin (krijohet herën e parë) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Email (rivendosja e fjalëkalimit) ---
# Gmail: Llogaria Google → Siguria → Verifikimi me 2 hapa → "App passwords" (fjalëkalim 16 shkronjash)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FARMABOT_URL=http://localhost:8501
